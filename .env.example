# Copy to .env in the project root. Never commit .env.
APP_ENV=development
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in production (32+ characters). Local development creates a persistent key in backend/data.
SECRET_KEY=
# DATABASE_URL=sqlite:///backend/data/depthwizard.db
# Default DB path is absolute and independent of the launcher's current directory.
# UPLOAD_DIR=D:/depth-wizard/backend/data/uploads
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
# Optional cloud mode. Match frontend VITE_AUTH_PROVIDER=supabase.
# AUTH_PROVIDER=supabase
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Cloud analysis always requires a verified signed-in user. Guests only get the browser demo.
# Set SUPABASE_SERVICE_ROLE_KEY as a Cloud Run Secret Manager binding, never in VITE_ or a committed file.
# TRUSTED_PROXY_HOPS=0 locally; set to 1 on Cloud Run to use the last trusted X-Forwarded-For client hop.
# TRUSTED_PROXY_HOPS=0
MAX_USER_DAILY_ANALYSES=5
MAX_IP_ANALYSES_PER_MINUTE=5
MAX_GLOBAL_DAILY_ANALYSES=50
MAX_USER_STORAGE_MB=50
UPLOAD_RETENTION_DAYS=365
MAX_INFERENCE_WAIT_SECONDS=10
INFERENCE_CONCURRENCY=1
MAX_IMAGE_MB=20
MAX_IMAGE_PIXELS=25000000
MAX_VIDEO_MB=100
MAX_BATCH_FILES=20
MAX_BATCH_MB=100
BATCH_TTL_SECONDS=3600
# Batch/video analysis are off by default for public access.
# ENABLE_BATCH_ANALYSIS=false
# ENABLE_VIDEO_ANALYSIS=false
# Optional: explicit no-model demo mode. Values remain illustrative.
# DEPTH_MODEL=procedural-fallback
# Optional first admin; only creates a missing account, never changes an existing role/password.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-this-password
