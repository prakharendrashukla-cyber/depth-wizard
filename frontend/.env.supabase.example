# Copy to frontend/.env.local, fill values, then restart Vite / rebuild production.
VITE_AUTH_PROVIDER=supabase
# Leave both blank for guest-only development.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key works too; NEVER use service_role or sb_secret_ here.
# VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_GOOGLE=false
# Optional fixed redirect origin; normally current origin is correct.
# VITE_AUTH_REDIRECT_URL=http://localhost:5173/
# VITE_API_BASE=/api
